SWELL_DEFINE_MENU_RESOURCE_BEGIN(IDR_MENU1)
    POPUP "&Файл"
    BEGIN
        MENUITEM "&Настройки аудио…\tCtrl+,",     ID_PREFERENCES
        MENUITEM "&Выйти",                       ID_QUIT
    END
    POPUP "&Debug"
    BEGIN
        MENUITEM "&Live Edit Mode\tCtrl+E",     ID_LIVE_EDIT
        MENUITEM "&Show Control Bounds\tCtrl+B", ID_SHOW_BOUNDS
        MENUITEM "&Show Drawn Area\tCtrl+D",    ID_SHOW_DRAWN
        MENUITEM "&Show FPS\tCtrl+F",           ID_SHOW_FPS
        MENUITEM SEPARATOR
        MENUITEM "&Снимок окна\tCtrl+Shift+S", ID_SCREENSHOT
    END
    POPUP "&Справка"
    BEGIN
        MENUITEM "&О программе",                      ID_ABOUT
        MENUITEM "&Руководство пользователя",                ID_HELP
    END
SWELL_DEFINE_MENU_RESOURCE_END(IDR_MENU1)



//EOF

